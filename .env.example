APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lc_pizza_data
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Rate limiting. Off = limits are logged (throttle.breach) but nothing gets a 429.
THROTTLE_ENFORCE=false

# Proxies allowed to set X-Forwarded-For/-Proto/-Host/-Port: comma-separated IPs or
# CIDRs, e.g. the gateway server's IP plus the local nginx/Docker network if one sits
# in front of PHP. Empty = trust none (request->ip() is whatever connects, so every
# IP-keyed limit and log counts all callers behind that hop as one).
# Never use * : it trusts whoever connects, so any caller could forge its IP.
TRUSTED_PROXIES=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Report builder: API base of each service (with its /api prefix). Empty = not asked.
# REPORTS_DATA_URL defaults to APP_URL/api (Data asks itself over loopback).
# REPORTS_DATA_URL=http://localhost/api
REPORTS_OPERATIONS_URL=
REPORTS_TOOLBOX_URL=
REPORTS_HIRING_URL=
REPORTS_INVENTORY_URL=
REPORTS_MAINTENANCE_URL=
REPORTS_SCREENS_URL=
REPORTS_AUDIT_URL=
REPORTS_PREVIEW_TIMEOUT=15
REPORTS_READ_TIMEOUT=300
REPORTS_CATALOG_TIMEOUT=5
# Dashboard base URL, no locale (e.g. https://portal.example.com): the links in scheduled report
# notifications and emails. Required: a scheduled run fails while it is empty.
REPORTS_DASHBOARD_URL=
